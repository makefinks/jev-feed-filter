{
  "manifest_version": 3,
  "name": "Jev Feed Filter",
  "version": "0.1.1",
  "description": "Smart, dynamic AI filtering for X and YouTube feeds.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.youtube.com/*",
    "https://api.typesafe.ai/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "controls.html",
    "default_title": "Jev Feed Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "controls.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
